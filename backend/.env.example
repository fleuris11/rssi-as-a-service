# Copy to backend/.env and fill in real values. Never commit the real .env.
#
# These DATABASE_URL/REDIS_URL values target Postgres/Redis as exposed on
# localhost by docker-compose (for running manage.py/pytest directly on
# the host). docker-compose.yml overrides both with the in-network service
# hostnames when running the "web" container itself, so you don't need to
# duplicate the password there — it reads it from the repo-root .env.

DJANGO_SECRET_KEY=change-me-to-a-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://rssiasservice:change-me@localhost:5433/rssiasservice
REDIS_URL=redis://localhost:6379/0
# Celery broker/backend: a different Redis DB index than REDIS_URL above,
# so cache keys and task/queue data never collide.
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# Email: leave DJANGO_EMAIL_BACKEND unset to use the console backend in dev
# (DEBUG=True) automatically. In production, set:
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=RSSI as a Service <no-reply@rssiasservice.online>

# IA (Phase 4) : clé API Anthropic — jamais commitée, appel exclusivement
# via apps.ai_assistant.services (CLAUDE.md).
ANTHROPIC_API_KEY=

# Clé Fernet chiffrant la table de correspondance de pseudonymisation
# (ADR-005). Générer avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_PSEUDONYMIZATION_KEY=
AI_PSEUDONYMIZATION_TTL_HOURS=24
AI_DEFAULT_MONTHLY_TOKEN_LIMIT=200000

# 2FA TOTP (Phase 5) : clé Fernet dédiée chiffrant le secret TOTP au repos —
# distincte de AI_PSEUDONYMIZATION_KEY. Générer avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=

# Secrets de fuite Breachsense (ADR-014, mise à jour) : clé Fernet dédiée
# chiffrant au repos le secret (mot de passe/token/cookie/carte) d'un
# BreachFinding — distincte de TOTP_ENCRYPTION_KEY et AI_PSEUDONYMIZATION_KEY.
# Générer avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BREACH_SECRET_ENCRYPTION_KEY=

# Threat intelligence / Breachsense (Phase 7, ADR-013) : licence Essentials
# unique, partagée par toute la plateforme (1000 req "query"/mois, 15 actifs
# monitorés, 1 req/s). Laisser vide en dev/CI : bascule automatiquement sur
# le NullProvider (aucun appel réel, findings vides).
BREACHSENSE_LICENSE_KEY=
BREACHSENSE_BASE_URL=https://api.breachsense.com
# Mode de fourniture des données CTI (Phase 8A, ADR-015) :
#   live   = appels réels (CONSOMME le quota partagé de 1000 req/mois)
#   replay = rejoue les cassettes enregistrées, aucun appel réseau
#   null   = aucune donnée, aucun appel
#   auto   = (défaut) replay si des cassettes existent, sinon null — jamais live.
# Laisser vide/auto en développement : disposer d'une licence ne doit jamais
# suffire à la dépenser par accident.
BREACHSENSE_MODE=auto
BREACHSENSE_QUOTA_SAFETY_MARGIN=50
BREACHSENSE_SCAN_COOLDOWN_HOURS=24
BREACHSENSE_MONITORED_ASSET_POOL_SIZE=15
# Identifiants HTTP Basic du webhook entrant POST /api/v1/webhooks/breachsense
# — à configurer aussi côté Breachsense (/account?action=add&creds=...).
BREACHSENSE_WEBHOOK_USERNAME=
BREACHSENSE_WEBHOOK_PASSWORD=
# URL publique du webhook — vide en local (pas d'URL publique), à définir
# en production, ex: https://rssiasservice.online/api/v1/webhooks/breachsense
BREACHSENSE_WEBHOOK_CALLBACK_URL=
