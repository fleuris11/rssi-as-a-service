# Multi-stage: build the React SPA, then bake it into the Caddy image
# alongside deploy/Caddyfile. Built from the repo root (see
# docker-compose.prod.yml: build.context: ..), so it can COPY both
# frontend/ and deploy/Caddyfile.

FROM node:22-alpine AS frontend-build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# Empty (not unset): the frontend then calls the API on the same origin
# Caddy serves it from, via the @backend proxy block below — see the ??
# (not ||) in frontend/src/api/client.js, which is what makes an empty
# string mean "same origin" instead of falling back to the dev default.
ENV VITE_API_URL=""
RUN npm run build

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=frontend-build /app/dist /srv
